# Local Caido UI/API listener. The onboarding doctor probes loopback URLs only.
CAIDO_URL=http://127.0.0.1:8080

# Start safely. Active mode requires explicit authorization and selected scope.
CAIDO_AGENT_MODE=read-only

# Keep scope enforcement enabled for every active operation.
CAIDO_REQUIRE_SCOPE=true

# Sensitive request and response headers remain redacted by default.
CAIDO_ALLOW_SENSITIVE_HEADERS=false

# Bound data returned to the AI client.
CAIDO_BODY_LIMIT=4096
CAIDO_MAX_BATCH=20

# Stop slow upstream operations instead of retrying mutations.
CAIDO_REQUEST_TIMEOUT_MS=15000

# Do not add CAIDO_PAT or CAIDO_TOKEN here. Supply credentials through your
# AI client's private environment or secret manager.
