{
  "name": "caido-agent-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:skill": "node skills/caido-operator/scripts/verify-skill.mjs && vitest run --project skill",
    "test:docs": "vitest run --project docs",
    "eval:skill": "vitest run --project skill",
    "generate:tools": "tsx scripts/generate-tool-reference.ts",
    "check:generated": "tsx scripts/check-generated-files.ts",
    "coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings .",
    "typecheck": "tsc -b --pretty false",
    "build": "pnpm -r build",
    "audit:high": "pnpm audit --audit-level high",
    "scan:secrets": "tsx scripts/secret-scan.ts",
    "license:inventory": "tsx scripts/license-inventory.ts",
    "release:check": "tsx scripts/release-check.ts",
    "config:client": "tsx scripts/print-client-config.ts",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:contract && pnpm test:integration && pnpm test:skill && pnpm eval:skill && pnpm test:docs && pnpm check:generated && pnpm coverage && pnpm build && pnpm audit:high && pnpm scan:secrets && pnpm license:inventory"
  },
  "devDependencies": {
    "@caido/sdk-client": "0.5.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/node": "26.1.1",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.1.10",
    "oxlint": "1.12.0",
    "prettier": "3.6.2",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "ws": "8.21.0",
    "zod": "4.4.3"
  }
}
